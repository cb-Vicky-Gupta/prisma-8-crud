// use prisma-8

// Define your models here, then run `npm run contract:emit`.

model User {
  id           id.uuidv7String()
  email        String                     @unique
  passwordHash String
  name         String
  createdAt    temporal.createdAtString()
  updatedAt    temporal.updatedAtString()
}
model Task {
  id          Int                        @id @default(autoincrement())
  task        String
  description String?
  createdAt   temporal.createdAtString()
  updatedAt   temporal.updatedAtString()
}

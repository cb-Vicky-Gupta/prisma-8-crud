# Copy this file to `.env` and adjust values.
# PostgreSQL >= 15 required. Defaults match docker-compose.yml (`npm run db:up`).
DATABASE_URL="postgresql://myuser:mysecurepassword@localhost:5432/mydatabase"

PORT=8080

# Secret used to sign auth tokens. Use a long random string outside local dev.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
